# Supabase project URL and publishable key (Project Settings > API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# WebSocket URL of the battle server, e.g. wss://battle.example.com (used from phase 4 on).
NEXT_PUBLIC_BATTLE_SERVER_URL=

# Only for `pnpm e2e`: an existing, confirmed test account.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
